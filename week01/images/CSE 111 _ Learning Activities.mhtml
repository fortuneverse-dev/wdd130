<text x=3D"5" y=3D"2">import math</text>
<text x=3D"5" y=3D"6"># Define the main function.</text>
<text x=3D"5" y=3D"8">def main():</text>
<text x=3D"9" y=3D"10"># Get a radius and a height from the user.</text>
<text x=3D"9" y=3D"12">r =3D float(input("Enter the radius of a cylinder: "=
))</text>
<text x=3D"9" y=3D"14">h =3D float(input("Enter the height of a cylinder: "=
))</text>
<text x=3D"9" y=3D"18"># Call the compute_cylinder_volume function and stor=
e</text>
<text x=3D"9" y=3D"20"># its returned value in a variable to use later.</te=
xt>
<text x=3D"9" y=3D"22" class=3D"em">v =3D compute_cylinder_volume(r, h)</te=
xt>
<text x=3D"9" y=3D"26"># Print the volume of the cylinder.</text>
<text x=3D"9" y=3D"28">print(f"Volume: {v:.2f}")</text>
<text x=3D"5" y=3D"34"># Define a function that accepts two parameters.</te=
xt>
<text x=3D"5" y=3D"36">def compute_cylinder_volume(radius, height):</text>
<text x=3D"9" y=3D"38">"""Compute return the volume of a cylinder.</text>
<text x=3D"9" y=3D"40">Parameters</text>
<text x=3D"13" y=3D"42">radius: the radius of the cylinder</text>
<text x=3D"13" y=3D"44">height: the height of the cylinder</text>
<text x=3D"9" y=3D"46">Return: the volume of the cylinder</text>
<text x=3D"9" y=3D"48">"""</text>
<text x=3D"9" y=3D"50"># Compute the volume of the cylinder.</text>
<text x=3D"9" y=3D"52" class=3D"em">volume =3D math.pi * radius**2 * height=
</text>
<text x=3D"9" y=3D"56"># Return the volume of the cylinder so that it</text=
>
<text x=3D"9" y=3D"58"># can be used at the call point in this program.</te=
xt>
<text x=3D"9" y=3D"60" class=3D"em">return volume</text>
<text x=3D"5" y=3D"66"># Start this program by</text>
<text x=3D"5" y=3D"68"># calling the main function.</text>
<text x=3D"5" y=3D"70">main()</text>

rd); }

.step-reset { counter-reset: step 0; }

.step { counter-increment: step 1; }

.step::before { content: "Step " counter(step) ":  "; font-size: x-large; c=
olor: var(--navy); }

.part-reset { counter-reset: part 0; }

.part { counter-increment: part 1; margin-left: 1rem; }

.part::before { content: "Part " counter(part) ":  "; font-size: x-large; c=
olor: var(--navy); }

.check { list-style: "=E2=98=91=EF=B8=8F "; }

#weeks { list-style: none; padding-left: 1rem; }

#weeks li { margin-left: 0px; margin-right: 1rem; border: 1px solid rgba(0,=
 0, 0, 0.1); padding: 0.25rem 0.5rem; }

#weeks li a { display: block; text-decoration: none; color: rgb(0, 0, 0); }

#weeks li:hover { background-color: var(--byuiblue); }

#weeks li a:hover { font-weight: 700; text-decoration: underline; color: rg=
b(255, 255, 255); }

@media screen and (min-width: 600px) {
  .page { position: relative; }
  .logo { width: 75px; padding: 18px 15px; top: -0.5rem; right: 1rem; }
  h1 { font-size: 1.3rem; }
  #coursetitle { display: inline; }
}

@media screen and (min-width: 800px) {
  .logo { width: 100px; padding: 22px 20px; }
  h1 { font-size: 1.75rem; margin-left: 0px; }
}

pre.console { border: 1px solid var(--border-color); background-color: var(=
--console-bk-color); padding: 12px; }

li pre.console { margin-left: 0px; }

pre.console > span.input { border: 1px solid var(--border-color); padding: =
0px 0.25em; background-color: var(--user-input-bk-color); color: var(--user=
-input-fg-color); }

pre.console > span.pass { color: green; }

pre.console > span.fail { color: red; }

dfn { color: var(--dfn-fg-color); }

table.hljs-ln { width: 100%; background-color: inherit; }

td.hljs-ln-numbers { text-align: right; color: rgb(204, 204, 204); border-r=
ight: 1px solid rgb(153, 153, 153); vertical-align: top; padding-right: 10p=
x; margin-right: 5px; user-select: none; }

td.hljs-ln-code { padding-left: 10px; text-align: left; margin-left: 5px; }

code { white-space: pre-wrap; overflow: auto; }

pre code.nohljsln { text-align: left; }

.todo::before { content: "=E2=98=A0"; display: inline; color: white; backgr=
ound-color: black; font-size: 200%; }

ol.nested { list-style-type: none; counter-reset: item 0; }

ol.nested li { display: block; }

ol.nested li::before { content: counters(item, ".") " "; counter-increment:=
 item 1; }

ol.nested ol { list-style-type: none; counter-reset: subitem 0; margin-left=
: 1em; }

ol.nested ol li::before { content: counters(item, ".") "." counters(subitem=
, ".") " "; counter-increment: subitem 1; }

ol.nested li::marker { font-weight: bold; }

.no-bullets { list-style-type: none; padding: 0px; margin: 0px; }

.center-inline-img { vertical-align: middle; }

#function_specs th, #function_specs td { text-align: left; vertical-align: =
top; }

.column-left { text-align: left; }

code.no-hljs-copy + div.hljs-copy-container { display: none; }

.ai-agent { position: absolute; width: 1px; height: 1px; margin: -1px; padd=
ing: 0px; border: 0px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); cl=
ip-path: inset(50%); white-space: nowrap; }
